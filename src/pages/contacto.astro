---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contacto — IngresosConIA"
  description="Escríbeme para consultas sobre Shopify, automatización con IA, colaboraciones o simplemente para saludar."
>
  <div class="container-xl py-12 max-w-3xl">
    <div class="text-center mb-12">
      <h1 class="text-4xl font-extrabold text-gray-900 dark:text-white mb-4">Contacto</h1>
      <p class="text-xl text-gray-500 dark:text-gray-400">
        ¿Tienes un proyecto, una pregunta o quieres colaborar? Escríbeme.
      </p>
    </div>

    <!-- Contact cards -->
    <div class="grid sm:grid-cols-3 gap-4 mb-12">
      {[
        { emoji: '🛒', title: 'Proyectos Shopify', desc: 'Crear o mejorar tu tienda online' },
        { emoji: '🤖', title: 'Automatización IA', desc: 'Flujos con n8n, Make o API de Claude' },
        { emoji: '🤝', title: 'Colaboraciones', desc: 'Patrocinios o menciones en el blog' },
      ].map(card => (
        <div class="bg-gray-50 dark:bg-gray-800 rounded-xl p-5 text-center">
          <span class="text-3xl mb-3 block">{card.emoji}</span>
          <p class="font-bold text-gray-900 dark:text-white text-sm mb-1">{card.title}</p>
          <p class="text-xs text-gray-500 dark:text-gray-400">{card.desc}</p>
        </div>
      ))}
    </div>

    <!-- Form -->
    <div class="card border border-gray-100 dark:border-gray-700 p-8">
      <form
        method="POST"
        action="#"
        onsubmit="event.preventDefault(); document.getElementById('form-success').classList.remove('hidden'); this.classList.add('hidden');"
        class="space-y-6"
        novalidate
      >
        <div class="grid sm:grid-cols-2 gap-6">
          <div>
            <label for="name" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
              Nombre *
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              placeholder="Tu nombre"
              class="input-field"
            />
          </div>
          <div>
            <label for="email" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
              Email *
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="tu@email.com"
              class="input-field"
            />
          </div>
        </div>

        <div>
          <label for="subject" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
            Asunto *
          </label>
          <select id="subject" name="subject" required class="input-field">
            <option value="">Selecciona un asunto</option>
            <option value="shopify">Proyecto Shopify</option>
            <option value="automatizacion">Automatización con IA</option>
            <option value="consultoria">Consultoría e-commerce</option>
            <option value="colaboracion">Colaboración / patrocinio</option>
            <option value="otro">Otro</option>
          </select>
        </div>

        <div>
          <label for="message" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">
            Mensaje *
          </label>
          <textarea
            id="message"
            name="message"
            required
            rows="6"
            placeholder="Cuéntame tu proyecto o pregunta..."
            class="input-field resize-none"
          ></textarea>
        </div>

        <div class="flex items-start gap-3">
          <input type="checkbox" id="privacy" name="privacy" required class="mt-1 w-4 h-4 text-accent-500 rounded border-gray-300 focus:ring-accent-500" />
          <label for="privacy" class="text-sm text-gray-600 dark:text-gray-400">
            He leído y acepto la
            <a href="/politica-de-privacidad" class="text-accent-600 dark:text-accent-400 hover:underline">Política de Privacidad</a>
            y consiento el tratamiento de mis datos para responder a mi consulta.
          </label>
        </div>

        <button type="submit" class="btn-primary w-full justify-center py-3">
          Enviar mensaje →
        </button>

        <p class="text-xs text-gray-400 dark:text-gray-500 text-center">
          Suelo responder en 24-48 horas laborables.
        </p>
      </form>

      <!-- Success message -->
      <div id="form-success" class="hidden text-center py-8">
        <span class="text-5xl mb-4 block">✅</span>
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">¡Mensaje enviado!</h2>
        <p class="text-gray-500 dark:text-gray-400">
          Gracias por escribirme. Te responderé en 24-48 horas laborables.
        </p>
      </div>
    </div>

    <!-- Note about form backend -->
    <div class="mt-6 p-4 bg-blue-50 dark:bg-blue-900/20 border border-blue-100 dark:border-blue-800 rounded-lg text-sm text-blue-700 dark:text-blue-300">
      <strong>Nota para el propietario del sitio:</strong> Este formulario necesita un backend para enviar emails.
      Conecta con <a href="https://formspree.io" class="underline" target="_blank" rel="noopener">Formspree</a>,
      <a href="https://netlify.com/products/forms/" class="underline" target="_blank" rel="noopener">Netlify Forms</a>
      o implementa tu propio endpoint. Actualiza el atributo <code>action</code> del formulario.
    </div>
  </div>
</BaseLayout>
