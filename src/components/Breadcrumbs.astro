---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  crumbs: Crumb[];
}

const { crumbs } = Astro.props;
---

<nav aria-label="Breadcrumb" class="py-3">
  <ol class="flex flex-wrap items-center gap-1 text-sm text-gray-500 dark:text-gray-400" itemscope itemtype="https://schema.org/BreadcrumbList">
    <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
      <a href="/" itemprop="item" class="hover:text-accent-600 dark:hover:text-accent-400 transition-colors">
        <span itemprop="name">Inicio</span>
      </a>
      <meta itemprop="position" content="1" />
    </li>
    {crumbs.map((crumb, i) => (
      <li class="flex items-center gap-1" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
        {crumb.href ? (
          <a href={crumb.href} itemprop="item" class="hover:text-accent-600 dark:hover:text-accent-400 transition-colors">
            <span itemprop="name">{crumb.label}</span>
          </a>
        ) : (
          <span itemprop="name" class="text-gray-900 dark:text-white font-medium">{crumb.label}</span>
        )}
        <meta itemprop="position" content={(i + 2).toString()} />
      </li>
    ))}
  </ol>
</nav>
